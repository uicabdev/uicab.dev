---
import { useTranslations } from '../../i18n/utils';
import { HERO_IMAGE_WEBP, HERO_IMAGE_PNG } from '../../consts';
import SocialLinks from '../../components/common/SocialLinks.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const quote = {
  es: '"El código es la última parte. No empiezo a escribir hasta entender qué problema estoy resolviendo — eso es lo que me permite construir productos de principio a fin."',
  en: '"Code is the last step. I don\'t start writing until I understand what problem I\'m solving — that\'s what allows me to build products from idea to launch."',
};
---

<section id="hero" class="flex min-h-[calc(100svh-4.5rem)] items-center">
  <div class="mx-auto w-full max-w-5xl px-6 py-20">
    <div class="grid items-center gap-12 md:grid-cols-2 md:gap-16">

      <!-- Texto -->
      <div class="flex flex-col gap-7">

        <!-- Badge disponibilidad -->
        <div
          data-reveal="fade"
          style="--reveal-delay: 0ms"
          class="flex w-fit items-center gap-2.5"
        >
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full motion-safe:animate-ping rounded-full bg-primary opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
          </span>
          <span class="text-sm text-text-muted">{t('hero.availability')}</span>
        </div>

        <!-- Nombre + rol -->
        <div data-reveal="up" style="--reveal-delay: 80ms" class="flex flex-col gap-1">
          <h1 class="font-heading text-4xl font-bold leading-tight text-primary-dark md:text-5xl">
            Manuel Uicab
          </h1>
          <p class="text-base font-medium text-text-muted">
            Frontend Developer
          </p>
        </div>

        <!-- Propuesta de valor -->
        <blockquote
          data-reveal="up"
          style="--reveal-delay: 160ms"
          class="font-heading text-2xl font-semibold leading-snug text-balance text-primary-dark"
        >
          {quote[lang]}
        </blockquote>

        <!-- CTAs -->
        <div data-reveal="up" style="--reveal-delay: 240ms" class="flex flex-wrap gap-3">
          <a
            href={`/${lang}/#projects`}
            class="inline-flex items-center bg-primary px-5 py-2.5 text-sm font-medium text-white transition-colors duration-200 hover:bg-primary-dark"
          >
            {t('hero.cta.primary')}
          </a>
          <a
            href={`/${lang}/#contact`}
            class="inline-flex items-center border border-surface-muted px-5 py-2.5 text-sm font-medium text-primary-dark transition-colors duration-200 hover:border-primary hover:text-primary"
          >
            {t('hero.cta.secondary')}
          </a>
        </div>

        <!-- Social links -->
        <div data-reveal="fade" style="--reveal-delay: 320ms">
          <SocialLinks />
        </div>
      </div>

      <!-- Foto -->
      <div class="flex justify-center md:justify-end">
        <div
          data-reveal="fade"
          style="--reveal-delay: 120ms"
          class="h-56 w-56 max-w-full overflow-hidden md:h-72 md:w-72"
        >
          <picture>
            <source srcset={HERO_IMAGE_WEBP} type="image/webp" />
            <img
              src={HERO_IMAGE_PNG}
              alt="Manuel Uicab"
              width="288"
              height="288"
              class="h-full w-full object-cover object-top"
            />
          </picture>
        </div>
      </div>

    </div>

    <!-- Scroll hint -->
    <div class="mt-20 flex justify-center">
      <a
        href={`/${lang}/#projects`}
        aria-label={t('hero.scroll')}
        class="scroll-hint inline-flex min-h-11 min-w-11 items-center justify-center text-text-muted transition-colors hover:text-primary"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="12" y1="5" x2="12" y2="19" />
          <polyline points="19 12 12 19 5 12" />
        </svg>
      </a>
    </div>
  </div>
</section>
