---
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import ProjectCard from './ProjectCard.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const collectionName = lang === 'es' ? 'projects-es' : 'projects-en';
const projects = (await getCollection(collectionName)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="projects" class="mx-auto max-w-5xl border-t border-surface-muted px-6 py-32">
  <div class="grid gap-12 md:grid-cols-[1fr_2fr] md:gap-16">

    <!-- Título de sección (sticky en desktop) -->
    <div>
      <h2 class="font-heading text-3xl font-bold text-primary-dark md:sticky md:top-24">
        {t('nav.work')}
      </h2>
    </div>

    <!-- Cards -->
    <div class="flex flex-col gap-10">
      {projects.map((project, i) => <ProjectCard project={project} lang={lang} index={i} />)}
    </div>

  </div>
</section>
