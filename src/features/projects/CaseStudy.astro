---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  project: CollectionEntry<'projects-es'> | CollectionEntry<'projects-en'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(project);

// Siguiente proyecto por orden; el último vuelve al primero.
const all = (await getCollection(lang === 'es' ? 'projects-es' : 'projects-en')).sort(
  (a, b) => a.data.order - b.data.order
);
const next = all[(all.findIndex(p => p.data.slug === project.data.slug) + 1) % all.length];
---

<article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
  <a
    href={`/${lang}/#projects`}
    class="inline-flex min-h-11 items-center gap-2 text-sm text-text-muted transition-colors hover:text-primary"
  >
    <span aria-hidden="true">←</span>
    {t('projects.back')}
  </a>

  <header class="mt-10">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <h1 class="font-heading text-3xl font-bold text-primary-dark md:text-4xl">
        {project.data.title}
      </h1>
      {project.data.status === 'in-progress' && (
        <span class="shrink-0 border border-primary px-2 py-0.5 text-xs text-primary">
          {t('projects.status.inprogress')}
        </span>
      )}
    </div>
    <p class="mt-4 text-base leading-relaxed text-text-muted">
      {project.data.description}
    </p>
  </header>

  <div
    class="mt-12 border-t border-surface-muted pt-4 [&_em]:font-medium [&_em]:not-italic [&_em]:text-primary-dark [&_h2]:mb-3 [&_h2]:mt-12 [&_h2]:font-heading [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-primary-dark [&_p]:mb-4 [&_p]:leading-relaxed [&_p]:text-primary-dark [&_strong]:font-medium [&_strong]:text-primary-dark"
  >
    <Content />
  </div>

  <footer class="mt-16 border-t border-surface-muted pt-10">
    {next && next.data.slug !== project.data.slug && (
      <a
        href={`/${lang}/work/${next.data.slug}/`}
        class="group block border border-surface-muted bg-surface p-6 transition-colors hover:border-primary"
      >
        <span class="text-sm text-text-muted">{t('projects.next')}:</span>
        <span class="mt-1 flex items-center justify-between gap-4 font-heading text-xl font-bold text-primary-dark">
          {next.data.title}
          <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
        </span>
      </a>
    )}
  </footer>
</article>
