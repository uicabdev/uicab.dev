---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

type StackGroup = { label: string; items: string[]; note?: string };

const groups: Record<'es' | 'en', StackGroup[]> = {
  es: [
    {
      label: 'Frontend',
      items: ['React (principal)', 'Astro (en aprendizaje)', 'TypeScript', 'JavaScript', 'Tailwind CSS', 'Zustand', 'Context API'],
    },
    {
      label: 'Backend',
      items: ['Node.js + Express', 'NestJS', 'Laravel / PHP', '.NET / C#'],
      note: '(adaptación, no decisiones técnicas)',
    },
    {
      label: 'Bases de datos',
      items: ['MySQL', 'PostgreSQL', 'SQL Server'],
    },
    {
      label: 'Testing',
      items: ['Vitest', 'Playwright'],
    },
    {
      label: 'Herramientas',
      items: ['Git / GitHub', 'GitHub Actions (CI/CD)', 'Docker', 'Postman', 'Claude Code'],
    },
  ],
  en: [
    {
      label: 'Frontend',
      items: ['React (main)', 'Astro (learning)', 'TypeScript', 'JavaScript', 'Tailwind CSS', 'Zustand', 'Context API'],
    },
    {
      label: 'Backend',
      items: ['Node.js + Express', 'NestJS', 'Laravel / PHP', '.NET / C#'],
      note: '(adaptation, not technical decisions)',
    },
    {
      label: 'Databases',
      items: ['MySQL', 'PostgreSQL', 'SQL Server'],
    },
    {
      label: 'Testing',
      items: ['Vitest', 'Playwright'],
    },
    {
      label: 'Tools',
      items: ['Git / GitHub', 'GitHub Actions (CI/CD)', 'Docker', 'Postman', 'Claude Code'],
    },
  ],
};
---

<section id="stack" class="mx-auto max-w-5xl border-t border-border px-6 py-24">
  <div class="grid gap-12 md:grid-cols-[1fr_2fr] md:gap-16">

    <!-- Título de sección (sticky en desktop) -->
    <div>
      <h2 class="font-heading text-3xl font-bold text-text-primary md:sticky md:top-24">
        {t('nav.stack')}
      </h2>
    </div>

    <!-- Grupos + nota -->
    <div class="flex flex-col gap-10">

      <!-- Grid de grupos 2×2 -->
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
        {groups[lang].map((group, i) => (
          <div
            data-reveal="up"
            style={`--reveal-delay: ${i * 90}ms`}
            class="flex flex-col gap-3"
          >
            <h3 class="text-xs font-medium uppercase tracking-wide text-accent">
              {group.label}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map(item => (
                <span class="border border-border px-2.5 py-1 text-sm text-text-secondary">
                  {item}
                </span>
              ))}
            </div>
            {group.note && (
              <p class="text-xs text-text-secondary">{group.note}</p>
            )}
          </div>
        ))}
      </div>

      <!-- Nota de adaptación -->
      <p class="border-t border-border pt-8 text-sm leading-relaxed text-text-secondary">
        {t('stack.note')}
      </p>

    </div>
  </div>
</section>
