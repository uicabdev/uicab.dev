---
import { useTranslations } from '../../i18n/utils';
import { EMAIL } from '../../consts';
import SocialLinks from '../../components/common/SocialLinks.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const availability = [
  t('contact.availability.fulltime'),
  t('contact.availability.freelance'),
  t('contact.availability.consulting'),
];
---

<section id="contact" class="bg-primary-dark">
  <div class="mx-auto max-w-5xl px-6 pb-6 pt-28">
    <div data-reveal="fade" class="flex max-w-3xl flex-col gap-10">

      <h2 class="font-heading text-4xl font-bold text-white md:text-5xl">
        {t('contact.title')}
      </h2>

      <p class="max-w-2xl text-lg leading-relaxed text-surface">
        {t('contact.description')}
      </p>

      <a
        href={`mailto:${EMAIL}`}
        class="self-start break-all font-heading text-3xl font-bold text-white underline decoration-surface-muted decoration-2 underline-offset-8 transition-colors hover:text-surface md:text-5xl"
      >
        {EMAIL}
      </a>

      <div class="flex flex-col gap-6">
        <p class="text-sm text-surface">{availability.join(' · ')}</p>
        <SocialLinks tone="inverse" />
      </div>

    </div>
  </div>
</section>
