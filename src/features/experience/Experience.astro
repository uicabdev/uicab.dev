---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const company = 'Innovaforce';
const role = 'Frontend Technical Reference';

const localized: Record<'es' | 'en', { period: string; paragraphs: string[]; footnote: string }> = {
  es: {
    period: 'Octubre 2018 · Presente',
    paragraphs: [
      'Entré a Innovaforce antes de terminar la carrera, como junior. Con el tiempo me convertí en la referencia técnica del equipo frontend — no por título, sino por lo que el trabajo fue pidiendo.',
      'En ese camino construí sistemas que hoy están en producción: una plataforma de gestión de créditos automotrices con múltiples actores y firma digital, un sistema de subastas multi-audiencia, y actualmente lidero el rediseño completo de un gestor de tareas interno. Cada proyecto me ha obligado a tomar decisiones que van más allá del código — arquitectura, estándares, criterio técnico.',
      'También acompaño al equipo: cuando hay un problema complejo, soy el primero en sentarme a resolverlo con ellos.',
    ],
    footnote: 'Incluye período de prácticas profesionales en modalidad de staffing externo — 2018.',
  },
  en: {
    period: 'October 2018 · Present',
    paragraphs: [
      "I joined Innovaforce before finishing my degree, as a junior. Over time I became the technical reference for the frontend team — not because of a title, but because the work gradually asked for it.",
      "Along the way I've built systems that are live in production: an automotive credit management platform with multiple actors and digital signing, a multi-audience asset auction system, and I'm currently leading a full rebuild of an internal task manager. Each project pushed me to make decisions beyond the code — architecture, standards, technical judgment.",
      "I also support the team: when a complex problem shows up, I'm the first one sitting down to work through it with them.",
    ],
    footnote: 'Includes internship period as external staffing — 2018.',
  },
};

const { period, paragraphs, footnote } = localized[lang];
---

<section id="experience" class="mx-auto max-w-5xl border-t border-surface-muted px-6 py-16">
  <div data-reveal="up" class="grid gap-12 md:grid-cols-[1fr_2fr] md:gap-16">

    <!-- Título de sección (sticky en desktop) -->
    <div>
      <h2 class="font-heading text-3xl font-bold text-primary-dark md:sticky md:top-24">
        {t('nav.experience')}
      </h2>
    </div>

    <!-- Entrada -->
    <div class="flex flex-col gap-6">

      <!-- Empresa + período + rol -->
      <div>
        <p class="font-heading font-bold text-primary-dark">
          {company}<span class="font-mono text-sm font-normal text-text-muted"> — {period}</span>
        </p>
        <p class="mt-1 font-heading font-medium text-text-muted">{role}</p>
      </div>

      <!-- Prosa -->
      <div class="flex flex-col gap-4 border-t border-surface-muted pt-6">
        {paragraphs.map(paragraph => (
          <p class="leading-relaxed text-primary-dark">{paragraph}</p>
        ))}
      </div>

      <!-- Nota al pie -->
      <p class="text-sm italic text-text-muted">{footnote}</p>

    </div>
  </div>
</section>
