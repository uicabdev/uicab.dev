---
import '../styles/global.css';
import { THEME_TOGGLE_ENABLED } from '../consts';
import SEO from '../components/common/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = 'es' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ allowDark: THEME_TOGGLE_ENABLED }}>
      (function () {
        document.documentElement.classList.add('js');
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (allowDark && (stored === 'dark' || (!stored && prefersDark))) {
            document.documentElement.classList.add('dark');
          }
        } catch (_) {}
      })();
    </script>
    <SEO title={title} description={description} lang={lang} />
  </head>
  <body class="bg-bg-base text-text-primary font-body min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-accent focus:text-bg-base focus:text-sm focus:font-medium"
    >
      {lang === 'en' ? 'Skip to content' : 'Ir al contenido'}
    </a>
    <slot />
    <script>
      const revealed = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            revealed.unobserve(entry.target);
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => revealed.observe(el));
    </script>
  </body>
</html>
