---
import { SOCIAL, CV_PATH } from '../../consts';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  tone?: 'default' | 'inverse';
  lang?: Lang;
}

const { tone = 'default', lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const linkClass =
  tone === 'inverse'
    ? 'inline-flex min-h-11 items-center text-surface hover:text-white transition-colors text-sm'
    : 'inline-flex min-h-11 items-center text-text-muted hover:text-primary-dark transition-colors text-sm';
---

<div class="flex flex-wrap items-center gap-x-4">
  <a
    href={SOCIAL.github}
    target="_blank"
    rel="noopener noreferrer"
    class={linkClass}
    aria-label="GitHub"
  >
    GitHub
  </a>
  <a
    href={SOCIAL.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    class={linkClass}
    aria-label="LinkedIn"
  >
    LinkedIn
  </a>
  <a
    href={CV_PATH}
    target="_blank"
    rel="noopener noreferrer"
    class={linkClass}
    aria-label={t('social.cv.download')}
  >
    CV ↓
  </a>
</div>
