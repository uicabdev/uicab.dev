---
import { useTranslations } from '../../i18n/utils';
import { CV_PATH, THEME_TOGGLE_ENABLED } from '../../consts';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const altLang = lang === 'es' ? 'en' : 'es';
const altHref = Astro.url.pathname.replace(`/${lang}/`, `/${altLang}/`);

const navLinks = [
  { href: `/${lang}/#projects`, label: t('nav.work') },
  { href: `/${lang}/#approach`, label: t('nav.approach') },
  { href: `/${lang}/#experience`, label: t('nav.experience') },
  { href: `/${lang}/#about`, label: t('nav.about') },
  { href: `/${lang}/#contact`, label: t('nav.contact') },
];
---

<header class="bg-surface border-b border-surface-muted sticky top-0 z-50">
  <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href={`/${lang}/`} class="font-heading font-bold text-primary-dark text-lg tracking-tight">
      uicab.dev
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-6">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="py-1 text-text-muted hover:text-primary-dark aria-[current=true]:text-primary-dark aria-[current=true]:underline aria-[current=true]:underline-offset-8 transition-colors text-sm"
          data-nav-link
        >
          {link.label}
        </a>
      ))}
      <div class="flex items-center text-xs font-medium uppercase tracking-wide">
        {(['es', 'en'] as const).map((code, i) => (
          <>
            {i > 0 && <span aria-hidden="true" class="h-3.5 w-px bg-surface-muted"></span>}
            {code === lang ? (
              <span aria-current="true" class="px-2 py-1.5 text-primary-dark">{code}</span>
            ) : (
              <a
                href={altHref}
                class="px-2 py-1.5 text-text-muted hover:text-primary transition-colors"
                aria-label={t('nav.lang.switch')}
              >
                {code}
              </a>
            )}
          </>
        ))}
      </div>
      {THEME_TOGGLE_ENABLED && (<button
        data-theme-toggle
        class="text-text-muted hover:text-primary-dark transition-colors w-5 h-5 flex items-center justify-center"
        aria-label={t('nav.theme.toggle')}
      >
        <!-- Sun: visible in dark mode to switch to light -->
        <svg class="hidden dark:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon: visible in light mode to switch to dark -->
        <svg class="block dark:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>)}
      <a
        href={CV_PATH}
        target="_blank"
        rel="noopener noreferrer"
        class="press border border-primary text-primary hover:bg-primary hover:text-white px-3 py-1.5 text-xs transition-colors font-medium"
      >
        {t('nav.cv')}
      </a>
    </div>

    <!-- Mobile controls (theme toggle + hamburger) -->
    <div class="flex items-center gap-1 md:hidden">
      <a
        href={`/${lang}/#contact`}
        class="inline-flex min-h-11 items-center px-3 text-sm font-medium text-primary transition-colors hover:text-primary-dark max-[259px]:hidden"
      >
        {t('nav.contact')}
      </a>
      {THEME_TOGGLE_ENABLED && (<button
        data-theme-toggle
        class="text-text-muted hover:text-primary-dark transition-colors w-11 h-11 flex items-center justify-center"
        aria-label={t('nav.theme.toggle')}
      >
        <svg class="hidden dark:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="block dark:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>)}
      <button
        id="menu-toggle"
        class="text-text-muted hover:text-primary-dark transition-colors w-11 h-11 flex items-center justify-center"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('nav.menu.open')}
      >
        <svg id="icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="icon-close" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu dropdown -->
  <div
    id="mobile-menu"
    class="hidden border-t border-surface-muted md:hidden"
    aria-hidden="true"
  >
    <div class="max-w-5xl mx-auto px-6 py-6 flex flex-col gap-5">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="inline-flex min-h-11 items-center text-text-muted hover:text-primary-dark aria-[current=true]:text-primary-dark aria-[current=true]:underline aria-[current=true]:underline-offset-8 transition-colors text-sm"
          data-nav-link
          data-mobile-nav-link
        >
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-4 pt-4 border-t border-surface-muted">
        <a
          href={altHref}
          class="text-text-muted hover:text-primary transition-colors text-xs font-medium uppercase tracking-wide"
        >
          {altLang === 'en' ? 'EN — English' : 'ES — Español'}
        </a>
        <a
          href={CV_PATH}
          target="_blank"
          rel="noopener noreferrer"
          class="press border border-primary text-primary hover:bg-primary hover:text-white inline-flex min-h-11 items-center px-4 text-xs transition-colors font-medium"
        >
          {t('nav.cv')}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Theme toggle — applies to all [data-theme-toggle] buttons (desktop + mobile)
  document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  });

  // Mobile menu
  const menuBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function openMenu() {
    mobileMenu?.classList.remove('hidden');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    menuBtn?.setAttribute('aria-expanded', 'true');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
  }

  function closeMenu() {
    mobileMenu?.classList.add('hidden');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    menuBtn?.setAttribute('aria-expanded', 'false');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.getAttribute('aria-hidden') === 'false';
    isOpen ? closeMenu() : openMenu();
  });

  // Close menu on nav link click (smooth scroll to section)
  document.querySelectorAll('[data-mobile-nav-link]').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Cerrar el menú con Escape (devolviendo el foco al botón) o al tocar fuera del header.
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && mobileMenu?.getAttribute('aria-hidden') === 'false') {
      closeMenu();
      menuBtn?.focus();
    }
  });
  document.addEventListener('click', e => {
    if (
      mobileMenu?.getAttribute('aria-hidden') === 'false' &&
      !(e.target as Element).closest('header')
    ) {
      closeMenu();
    }
  });

  // Sección activa: marca con aria-current el enlace de la sección visible (solo en la home).
  const navLinkEls = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const sections = document.querySelectorAll<HTMLElement>('main > section[id]');
  if (navLinkEls.length && sections.length && 'IntersectionObserver' in window) {
    const hashOf = (a: HTMLAnchorElement) => new URL(a.href).hash.slice(1);
    const setCurrent = (id: string) => {
      navLinkEls.forEach(a => {
        if (hashOf(a) === id) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };
    const io = new IntersectionObserver(
      entries => {
        entries.forEach(e => {
          if (e.isIntersecting) setCurrent((e.target as HTMLElement).id);
        });
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );
    sections.forEach(s => io.observe(s));
  }
</script>
